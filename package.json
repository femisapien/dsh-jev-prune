{
  "name": "dsh-jev-prune",
  "version": "0.1.1",
  "description": "Jev-judged context compaction for DeepSeek Harness. Two layers: prune stale tool results (semantic instead of size-only), and replace spent tool-call ranges with a deterministic receipt instead of a model-written summary.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./*.js": "./src/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "test",
    "scripts",
    "cordis.patch.yml",
    "assets",
    "examples",
    "docs",
    "demo",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node test/check.js",
    "smoke": "node test/smoke_apply.mjs",
    "demo": "node demo/run.mjs",
    "verify:current-host": "node scripts/verify_current_host.mjs",
    "coverage": "node --experimental-test-coverage --test --test-coverage-include=src/compatibility.js --test-coverage-include=src/jev.js --test-coverage-include=src/prune.js --test-coverage-include=src/receipt.js --test-coverage-include=src/state.js --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=75 test/check.js test/smoke_apply.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "license": "MIT",
  "author": {
    "name": "yangyu666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangyu666/dsh-jev-prune.git"
  },
  "bugs": {
    "url": "https://github.com/yangyu666/dsh-jev-prune/issues"
  },
  "homepage": "https://github.com/yangyu666/dsh-jev-prune#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "compaction",
    "context",
    "jev",
    "typesafe"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "testedAgainst": "@deepseek-ai/dsh@0.1.5-rc.2",
      "testedVersions": ["0.1.5-rc.2", "0.2.0-rc.2"],
      "supportedSeries": ["0.1", "0.2"],
      "note": "Version detection is dynamic; testedVersions records evidence, not a runtime pin. Unknown versions are reported and services are inspected. Latest-host install/activation is checked separately from the locked 0.1.5-rc.2 fixture."
    }
  }
}
